# 本板：ESP32-P4 rev v1.0 / 16 MB flash / 32 MB 片内 PSRAM（实测）
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y

# 从机目标：片内 C6（P4 上默认就是它，显式写出防漂移）
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y

# —— 下面这些是 WiFi/hosted 起得来且稳的**必需**项（p4_wifi_probe 那轮实测）——
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LWIP_TCPIP_TASK_PRIO=23
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
# 看门狗保留（工作区约定：卡住时它是唯一能救回设备的东西）；官方 iperf 例子关掉了它

# 显示层要求（见 P4 仓 notes/panel-ili9488-i80.md）
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# lwIP 接收邮箱：突发场景必需（B 实验：ffmpeg 成串出帧时，默认 UDP 邮箱=6 会溢出
# ⇒ 丢分片 ⇒ 整帧被丢帧策略丢掉，设备只显示出 9.4/30 fps ✗）。
# 官方 P4+hosted 的 sdkconfig.defaults.esp32p4 用的就是 64。
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
