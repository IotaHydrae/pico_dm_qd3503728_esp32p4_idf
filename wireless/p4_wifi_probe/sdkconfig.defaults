# 本板实测：ESP32-P4 rev v1.0，16 MB flash，32 MB 片内 PSRAM。
# 不设前两条，烧写会被 esptool 拒（requires chip revision [v3.0 - v3.99]）——
# 这是 pico_dm_qd3503728_esp32p4_idf 那一轮踩过的坑，直接继承。
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_100=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y

# 从机目标：P4 上默认就是 C6（esp_wifi_remote 的 Kconfig default），显式写出以防漂移。
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y

# 下面这段照抄 IDF examples/wifi/iperf/sdkconfig.defaults.esp32p4：
# 官方为 P4 调的远端 WiFi 缓冲与 lwIP 窗口（WIFI_RMT_* 就是"远端 WiFi"命名空间）。
CONFIG_WIFI_RMT_STATIC_RX_BUFFER_NUM=16
CONFIG_WIFI_RMT_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_WIFI_RMT_DYNAMIC_TX_BUFFER_NUM=64
CONFIG_WIFI_RMT_AMPDU_TX_ENABLED=y
CONFIG_WIFI_RMT_TX_BA_WIN=32
CONFIG_WIFI_RMT_AMPDU_RX_ENABLED=y
CONFIG_WIFI_RMT_RX_BA_WIN=32
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=65534
CONFIG_LWIP_TCP_WND_DEFAULT=65534
CONFIG_LWIP_TCP_RECVMBOX_SIZE=64
CONFIG_LWIP_UDP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64
CONFIG_LWIP_TCP_SACK_OUT=y

# 探针要能看清 hosted 的枚举过程，日志级别保持 INFO。
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# ---- hosted + WiFi 需要的整块配置（来源写清楚，别当魔法）----
# 微雪 10_wifistation 的 sdkconfig.defaults（这块板 + 片内 C6 的实测配置）：
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_BOOTLOADER_LOG_LEVEL_WARN=y

# IDF examples/wifi/iperf/sdkconfig.defaults（官方为 P4+hosted 测过）：
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_IN_IRAM=y
CONFIG_LWIP_IRAM_OPTIMIZATION=y
CONFIG_LWIP_TCPIP_TASK_PRIO=23
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_PHY_DEBUG=y
CONFIG_ESP_PHY_DISABLE_PLL_TRACK=y
# 注意：官方 iperf 还关掉了 INT_WDT / TASK_WDT（为了极限吞吐），这里**故意保留**
# 看门狗 —— 按本工作区约定，看门狗是"卡住时唯一能救回设备"的东西；
# 若出现误触发（hosted 高优先级任务饿死 IDLE）再单独评估。

# 内部 RAM 不够的直接解药（这次 0x101=ESP_ERR_NO_MEM 就是它）：
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
